rules_version = '2';
// DBAMINHS School Portal: Firestore Security Rules
// I-publish ito sa Firebase Console > Firestore Database > Rules
// PAGKATAPOS lang mailipat ang lahat ng account (Admin > Admin Accounts > Seguridad ng Login).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function roleRef() { return /databases/$(database)/documents/roles/$(request.auth.uid); }
    function hasRole() {
      return signedIn() && exists(roleRef()) && get(roleRef()).data.get('disabled', false) != true;
    }
    function myRole() { return get(roleRef()).data.role; }
    function isSuper() { return hasRole() && myRole() == 'super'; }
    function isAdmin() { return hasRole() && myRole() in ['super', 'principal']; }
    function isAdminViewer() { return hasRole() && myRole() in ['super', 'principal', 'viewer']; }
    function isStaff() { return hasRole() && myRole() in ['super', 'principal', 'teacher']; }
    function userRoles() { return ['student', 'parent', 'teacher']; }

    // Mga document na nababasa kahit hindi naka-login (homepage at DTR)
    function isPublicRead(key) {
      return key in ['settings', 'news', 'events', 'achievements', 'alumni', 'gallery', 'history',
                     'dtr_settings', 'dtr_roster', 'dtr_daily_code', 'dtr_employees']
        || key.matches('dtr_code_.*')
        || key.matches('dtr_[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    // DTR (Phase 1): nananatiling bukas ang pagsulat gaya ng dati
    function isPublicWrite(key) {
      return key in ['dtr_daily_code', 'dtr_employees'] || key.matches('dtr_[0-9]{4}-[0-9]{2}-[0-9]{2}');
    }
    // Mga document na puwedeng baguhin ng teacher
    function isStaffKey(key) {
      return key in ['scheduleMeta', 'quizzes', 'announcements', 'assignments',
                     'gradeRelease', 'gradeStudentRelease', 'gradeLock']
        || key.matches('(attendance|schedule|gradeReq)_.*');
    }
    // Grade sheet: hindi na mababago ng teacher kapag naka-lock (locks/{section_term})
    function lockRef(key) { return /databases/$(database)/documents/locks/$(key.replace('^grades_', '')); }
    function gradeSheetOpen(key) {
      return !exists(lockRef(key)) || get(lockRef(key)).data.get('locked', false) != true;
    }

    match /portal_data/{key} {
      allow read: if isPublicRead(key) || hasRole();
      allow write: if (isSuper())
                   || (isAdmin() && !(key in ['settings', 'admin_accounts', 'admin_auth']))
                   || isPublicWrite(key)
                   || (isStaff() && isStaffKey(key))
                   || (isStaff() && key.matches('grades_.*') && gradeSheetOpen(key))
                   || (hasRole() && key.matches('quiz_results_.*'));
    }

    // Role ng bawat user (Firebase Auth uid)
    match /roles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdminViewer());
      allow list: if isAdmin();
      allow create: if isSuper() || (isAdmin() && request.resource.data.role in userRoles());
      allow update: if isSuper()
                    || (isAdmin() && resource.data.role in userRoles() && request.resource.data.role in userRoles())
                    // ang user mismo: puwede lang alisin ang "mustChange" pagkatapos magpalit ng password
                    || (signedIn() && request.auth.uid == uid
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChange'])
                        && request.resource.data.mustChange == false);
      allow delete: if isSuper() || (isAdmin() && resource.data.role in userRoles());
    }

    // LRN / Employee ID / email -> panloob na Auth email (kailangan bago mag-login)
    match /login_map/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow write: if isSuper() || (isAdmin() && !id.matches('admin:.*'));
    }

    // Grade Lock na ipinapatupad ng server
    match /locks/{key} {
      allow read: if hasRole();
      allow create, update: if isAdmin() || (isStaff() && request.resource.data.locked == true);
      allow delete: if isAdmin();
    }

    // Mga inbox: puwedeng magpadala ang public, admin lang ang makakabasa
    match /signup_inbox/{uid} {
      allow create: if signedIn() && request.auth.uid == uid && request.resource.data.keys().size() <= 20;
      allow read, delete: if isAdmin();
    }
    match /reset_inbox/{id} {
      allow create: if request.resource.data.keys().hasOnly(['loginId', 'name', 'note', 'at'])
                    && request.resource.data.loginId is string && request.resource.data.loginId.size() <= 100
                    && request.resource.data.name is string && request.resource.data.name.size() <= 100;
      allow read, delete: if isAdmin();
    }
    match /enroll_inbox/{id} {
      allow create: if request.resource.data.keys().size() <= 80;
      allow read, delete: if isAdmin();
    }
  }
}
